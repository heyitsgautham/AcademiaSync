# For `npm run dev`. docker compose reads the root .env instead.

# Browser-side API URLs, baked in at build time
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_COURSE_SERVICE_URL=http://localhost:5001

# Server-side API URLs used by the Next.js route handlers and NextAuth
INTERNAL_BACKEND_URL=http://localhost:5000
INTERNAL_COURSE_SERVICE_URL=http://localhost:5001

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me
NEXTAUTH_DEBUG=false

# Must match user-service
ANALYTICS_API_KEY=change-me
