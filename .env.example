# Settings for `docker compose up`. Copy to .env and fill in every value marked "required".
# Generate secrets with: openssl rand -base64 32

# --- Database (required: POSTGRES_PASSWORD) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=academiasync

# --- Host ports (the containers always listen on 5432, 5000, 5001 and 3000) ---
DB_PORT=5432
USER_SERVICE_PORT=5000
COURSE_SERVICE_PORT=5001

# --- Tokens issued by user-service and checked by course-service (required) ---
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Google OAuth client from https://console.cloud.google.com/apis/credentials (required) ---
# Add http://localhost:3000/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- NextAuth (required: NEXTAUTH_SECRET) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me
# Set to true only while debugging sign-in on a deployed build; it logs token details.
NEXTAUTH_DEBUG=false

# --- Admin access ---
# Comma-separated Google accounts that become Admin when they sign in.
ADMIN_EMAILS=you@example.com
# Shared by the frontend and user-service to unlock /admin/analytics.
ANALYTICS_API_KEY=change-me

# --- Logging: trace, debug, info, warn, error or silent ---
LOG_LEVEL=info
