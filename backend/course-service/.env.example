# For running course-service on its own with `npm run dev`. docker compose reads the root .env instead.
PORT=5001
NODE_ENV=development
LOG_LEVEL=info

# Either a full connection string (used when set, e.g. Supabase)...
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/academiasync
# ...or the individual settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=academiasync
DB_USER=postgres
DB_PASSWORD=change-me

# Must match user-service, which signs the tokens
JWT_SECRET=change-me

# Allowed CORS origins
FRONTEND_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Base URLs used in HATEOAS links and the Swagger page
API_BASE_URL=http://localhost:5001
USER_SERVICE_URL=http://localhost:5000

# When set, GET /metrics requires `Authorization: Bearer <token>`
METRICS_TOKEN=
