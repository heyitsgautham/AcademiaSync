# Cloud Run image, built from the repo root: docker build -f frontend/Dockerfile.cloudrun .
FROM node:26-alpine

WORKDIR /app

# npm ci checks the lockfile against every workspace manifest, so all three are copied
COPY package.json package-lock.json ./
COPY backend/user-service/package.json backend/user-service/
COPY backend/course-service/package.json backend/course-service/
COPY frontend/package.json frontend/
RUN npm ci --workspace frontend --no-audit --no-fund

COPY frontend ./frontend

# Accept build arguments for Next.js environment variables
ARG NEXT_PUBLIC_BACKEND_URL
ARG NEXT_PUBLIC_COURSE_SERVICE_URL
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL
ENV NEXT_PUBLIC_COURSE_SERVICE_URL=$NEXT_PUBLIC_COURSE_SERVICE_URL

# Build for production
RUN npm run build --workspace frontend

# Expose port (Cloud Run uses PORT env variable, defaults to 8080)
EXPOSE 8080
ENV PORT=8080
ENV HOSTNAME=0.0.0.0

# The standalone server, with the static files it serves copied beside it
RUN cp -R frontend/.next/static frontend/.next/standalone/frontend/.next/static && \
    cp -R frontend/public frontend/.next/standalone/frontend/public
CMD ["node", "frontend/.next/standalone/frontend/server.js"]
