# For running user-service on its own with `npm run dev`. docker compose reads the root .env instead.
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Either a full connection string (used when set, e.g. Supabase)...
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/academiasync
# ...or the individual settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=academiasync
DB_USER=postgres
DB_PASSWORD=change-me

# Must match course-service
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
ADMIN_EMAILS=you@example.com
ANALYTICS_API_KEY=change-me

# Failed sign-in and token-refresh attempts allowed per client IP in each window, then 429.
# Successful requests do not count. Windows are in milliseconds (900000 is 15 minutes).
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
REFRESH_RATE_LIMIT_MAX=30
REFRESH_RATE_LIMIT_WINDOW_MS=900000
# Proxy hops Express should trust when reading the client IP, e.g. 1 behind the AWS load balancer. Leave empty when unsure.
TRUST_PROXY=

# Allowed CORS origins
FRONTEND_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Base URLs used in HATEOAS links and the Swagger page
API_BASE_URL=http://localhost:5000
COURSE_SERVICE_URL=http://localhost:5001

# When set, GET /metrics requires `Authorization: Bearer <token>`
METRICS_TOKEN=
