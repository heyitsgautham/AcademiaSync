# Settings for the Google Cloud Run and Supabase scripts in deployment/.
# Copy to deployment/.env and fill in every value. Never commit deployment/.env.
# The scripts fetch the Cloud Run service URLs themselves, so none are listed here.

# --- Google Cloud project ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south1
ARTIFACT_REGISTRY_REPO=academiasync-repo

# --- Supabase Postgres, from Project settings > Database in the Supabase dashboard ---
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-supabase-database-password

# Google account that init-db.sh makes the first Admin
ADMIN_EMAIL=you@example.com

# --- Tokens (generate with: openssl rand -base64 32) ---
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Google OAuth client from https://console.cloud.google.com/apis/credentials ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- NextAuth and admin analytics ---
NEXTAUTH_SECRET=change-me
ANALYTICS_API_KEY=change-me
