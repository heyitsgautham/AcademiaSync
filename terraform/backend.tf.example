# Remote state for shared or CI use.
# 1. Create the bucket, lock table and key once with the bootstrap root module:
#      cd terraform/bootstrap
#      terraform init
#      terraform apply -var state_bucket_name=<globally unique name>
# 2. Copy this file to terraform/backend.tf and fill in the three outputs it printed.
# 3. From terraform/, run `terraform init -migrate-state`.
terraform {
  backend "s3" {
    bucket         = "<state_bucket output>"
    key            = "academiasync/prod/terraform.tfstate"
    region         = "us-east-1"
    encrypt        = true
    kms_key_id     = "<kms_key_arn output>"
    dynamodb_table = "<lock_table output>"
  }
}
