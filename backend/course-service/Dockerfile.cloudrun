# Use official Node.js LTS image
FROM node:25-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --omit=dev

# Copy application code
COPY . .

# Expose port (Cloud Run expects 8080)
EXPOSE 8080
ENV PORT=8080

# Start the application
CMD ["npm", "start"]
