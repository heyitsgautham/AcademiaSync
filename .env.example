# Settings for `docker compose up`. Copy to .env and fill in every value marked "required".
# Generate secrets with: openssl rand -base64 32

# --- Database (required: POSTGRES_PASSWORD) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=academiasync

# --- Host ports (the containers always listen on 5432, 5000, 5001 and 3000) ---
DB_PORT=5432
USER_SERVICE_PORT=5000
COURSE_SERVICE_PORT=5001

# --- Tokens issued by user-service and checked by course-service (required) ---
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Google OAuth client from https://console.cloud.google.com/apis/credentials (required) ---
# Add http://localhost:3000/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- NextAuth (required: NEXTAUTH_SECRET) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me
# Set to true only while debugging sign-in on a deployed build; it logs token details.
NEXTAUTH_DEBUG=false

# --- Admin access ---
# Comma-separated Google accounts that become Admin when they sign in.
ADMIN_EMAILS=you@example.com
# Shared by the frontend and user-service to unlock /admin/analytics.
ANALYTICS_API_KEY=change-me

# --- Brute-force protection for user-service ---
# Failed sign-in and token-refresh attempts allowed per client IP in each window, then 429.
# Successful requests do not count. Windows are in milliseconds (900000 is 15 minutes).
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
REFRESH_RATE_LIMIT_MAX=30
REFRESH_RATE_LIMIT_WINDOW_MS=900000
# Proxy hops Express should trust when reading the client IP, e.g. 1 behind the AWS load balancer. Leave empty when unsure.
TRUST_PROXY=

# --- Logging: trace, debug, info, warn, error or silent ---
LOG_LEVEL=info

# --- Metrics ---
# Host port for Prometheus when you start the monitoring profile.
PROMETHEUS_PORT=9090
# When set, GET /metrics on both services requires `Authorization: Bearer <token>`.
# Set it wherever a service port is reachable from the internet, such as Cloud Run. compose leaves it unset.
METRICS_TOKEN=

# --- Running a service outside Docker ---
# docker compose sets these inside each container and ignores the values below.
# They are listed so one file names every variable the code reads; each folder's own
# .env.example holds the same defaults for `npm run dev`.
NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_NAME=academiasync
DB_USER=postgres
DB_PASSWORD=change-me
# A full connection string wins over the DB_* values (Supabase, RDS). Leave empty for local Postgres.
DATABASE_URL=
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000
USER_SERVICE_URL=http://localhost:5000
COURSE_SERVICE_URL=http://localhost:5001
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_COURSE_SERVICE_URL=http://localhost:5001
INTERNAL_BACKEND_URL=http://localhost:5000
INTERNAL_COURSE_SERVICE_URL=http://localhost:5001
